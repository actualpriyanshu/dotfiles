# Show git branch in prompt (bash on Ubuntu, zsh on macOS)
parse_git_branch() {
     git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}
if [ -n "$ZSH_VERSION" ]; then
    setopt PROMPT_SUBST
    PS1='%n@%m %F{green}%~%F{yellow}$(parse_git_branch) %f$ '
else
    export PS1="\u@\h \[\e[32m\]\w\[\e[33m\]\$(parse_git_branch) \[\e[00m\]$ "
fi
